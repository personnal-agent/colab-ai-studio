#!/usr/bin/env bash
# Git Hook: pre-commit
# Quality Gate de Colab AI Studio (Python FastAPI & React TypeScript)
# Périmètre dynamique (Scope-Aware) :
#   - par défaut SCOPE=staged : contrôle du diff indexé uniquement (rapide)
#   - QUALITY_GATE_SCOPE=full : audit complet du dépôt (appelé par pre-push)

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCOPE="${QUALITY_GATE_SCOPE:-staged}"
if [ "$SCOPE" != "staged" ] && [ "$SCOPE" != "full" ]; then
    echo -e "${RED}❌ [Quality Gate] Périmètre inconnu : '$SCOPE' (attendu : staged|full).${NC}"
    exit 2
fi

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}🛡️  QUALITY GATE — Périmètre : ${SCOPE}${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# ==============================================================================
# 1. Contrôle Anti-Fuite de Secrets et Fichiers Protégés (Toujours sur l'index)
# ==============================================================================
echo -e "${BLUE}[1/4] Vérification de sécurité (fichiers sensibles et secrets)...${NC}"

# A. Détection de fichiers .env ou jetons de tunnel dans l'index
STAGED_SENSITIVE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(\.env(\.|$)|ngrok\.token|secrets/|.*\.pem$|.*\.key$)' | grep -v '\.env\.example' || true)
if [ -n "$STAGED_SENSITIVE" ]; then
    echo -e "${RED}❌ Tentative de validation de fichier confidentiel sensible :${NC}"
    echo -e "${YELLOW}$STAGED_SENSITIVE${NC}"
    echo -e "${YELLOW}👉 Seuls les fichiers de gabarits (ex. .env.example) sont autorisés dans le dépôt.${NC}"
    exit 1
fi

# B. Détection de motifs de secrets dans les lignes AJOUTÉES de l'index (hors .githooks/)
SECRET_PATTERN='(sk-[a-zA-Z0-9]{32,}|ghp_[a-zA-Z0-9]{36}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----)'
ADDED_SECRETS=$(git diff --cached --diff-filter=ACMR -U0 -- ':(exclude).githooks' | grep -E '^\+[^+]' | grep -E "$SECRET_PATTERN" || true)
if [ -n "$ADDED_SECRETS" ]; then
    echo -e "${RED}❌ Motif de clé privée ou jeton d'accès détecté dans les lignes ajoutées :${NC}"
    echo -e "${YELLOW}$ADDED_SECRETS${NC}"
    echo -e "${YELLOW}👉 Supprimez le secret du code et utilisez les variables d'environnement.${NC}"
    exit 1
fi

# C. Commentaires de masquage de linter interdits dans les lignes AJOUTÉES (hors .githooks/)
SUPPRESSION_PATTERN='(#\s*(noqa|type:\s*ignore|pylint:\s*disable)|\/\/\s*@ts-ignore)'
ADDED_SUPPRESSIONS=$(git diff --cached --diff-filter=ACMR -U0 -- ':(exclude).githooks' | grep -E '^\+[^+]' | grep -E "$SUPPRESSION_PATTERN" || true)
if [ -n "$ADDED_SUPPRESSIONS" ]; then
    echo -e "${RED}❌ Commentaires d'inhibition détectés dans les lignes ajoutées (# noqa, # type: ignore, // @ts-ignore) :${NC}"
    echo -e "${YELLOW}$ADDED_SUPPRESSIONS${NC}"
    echo -e "${YELLOW}👉 Corrigez l'erreur de typage ou de linter à la source au lieu de masquer le contrôle.${NC}"
    exit 1
fi

# ==============================================================================
# 2. Collecte des Fichiers Selon le Périmètre (Python & JS/TS)
# ==============================================================================
if [ "$SCOPE" = "full" ]; then
    PY_FILES=$(git ls-files | grep -E '\.py$' | grep -v '^\.githooks/' || true)
    JS_FILES=$(git ls-files | grep -E '\.(ts|tsx|js|jsx)$' | grep -v '^\.githooks/' || true)
else
    PY_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' | grep -v '^\.githooks/' || true)
    JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' | grep -v '^\.githooks/' || true)
fi

# ==============================================================================
# 3. Validation Backend (Python)
# ==============================================================================
echo -e "${BLUE}[2/4] Validation Backend Python...${NC}"
if [ -n "$PY_FILES" ]; then
    echo "  Fichiers Python ciblés :"
    echo "$PY_FILES" | sed 's/^/   • /'

    if [ "$SCOPE" = "staged" ]; then
        # Extraire la version indexée dans un répertoire temporaire pour valider ce qui sera réellement committé
        TMP_STAGED=$(mktemp -d)
        trap 'rm -rf "$TMP_STAGED"' EXIT
        git diff --cached -z --name-only --diff-filter=ACMR | grep -z -E '\.py$' | grep -z -v '^\.githooks/' | git checkout-index --prefix="$TMP_STAGED/" -z --stdin

        while IFS= read -r -d '' f; do
            if [ -f "$TMP_STAGED/$f" ]; then
                python3 -m py_compile "$TMP_STAGED/$f" 2>&1 || {
                    echo -e "${RED}❌ Erreur de syntaxe Python dans la version indexée : $f${NC}"
                    exit 1
                }
            fi
        done < <(git diff --cached -z --name-only --diff-filter=ACMR | grep -z -E '\.py$' | grep -z -v '^\.githooks/')

        if command -v ruff >/dev/null 2>&1; then
            echo "  Exécution de Ruff sur la version indexée..."
            (cd "$TMP_STAGED" && git diff --cached -z --name-only --diff-filter=ACMR | grep -z -E '\.py$' | grep -z -v '^\.githooks/' | xargs -0 ruff check) || {
                echo -e "${RED}❌ Erreurs de linter Ruff détectées dans la version indexée.${NC}"
                exit 1
            }
        fi
    else
        while IFS= read -r f; do
            if [ -f "$f" ]; then
                python3 -m py_compile "$f" 2>&1 || {
                    echo -e "${RED}❌ Erreur de syntaxe Python dans le fichier : $f${NC}"
                    exit 1
                }
            fi
        done <<< "$PY_FILES"

        if command -v ruff >/dev/null 2>&1; then
            echo "  Exécution de Ruff..."
            echo "$PY_FILES" | tr '\n' '\0' | xargs -0 ruff check || {
                echo -e "${RED}❌ Erreurs de linter Ruff détectées.${NC}"
                exit 1
            }
        fi
    fi
    echo -e "${GREEN}  ✓ Contrôles Python validés.${NC}"
else
    echo "  Aucun fichier Python à analyser."
fi

# ==============================================================================
# 4. Validation Frontend (TypeScript / JavaScript)
# ==============================================================================
echo -e "${BLUE}[3/4] Validation Frontend TypeScript/React...${NC}"
if [ -n "$JS_FILES" ]; then
    echo "  Fichiers Frontend ciblés :"
    echo "$JS_FILES" | sed 's/^/   • /'

    if [ -f "frontend/package.json" ]; then
        if [ ! -d "frontend/node_modules" ]; then
            echo -e "${RED}❌ Dépendances frontend manquantes dans frontend/node_modules.${NC}"
            echo -e "${YELLOW}👉 Exécutez 'cd frontend && npm install' avant de committer des fichiers frontend.${NC}"
            exit 1
        fi
        (cd frontend && npm run lint --if-present) || {
            echo -e "${RED}❌ Erreurs de linting frontend détectées.${NC}"
            exit 1
        }
    fi
    echo -e "${GREEN}  ✓ Contrôles Frontend validés.${NC}"
else
    echo "  Aucun fichier Frontend à analyser."
fi

# ==============================================================================
# 5. Validation Globale (si périmètre full)
# ==============================================================================
echo -e "${BLUE}[4/4] Validation des invariants d'architecture...${NC}"
if [ "$SCOPE" = "full" ]; then
    if [ -f ".github/scripts/verify_workflows.py" ]; then
        python3 .github/scripts/verify_workflows.py .github/workflows >/dev/null 2>&1 || {
            echo -e "${RED}❌ Invariants de sécurité des workflows GitHub non respectés.${NC}"
            exit 1
        }
    fi
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ Quality Gate passée avec succès (${SCOPE}).${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
exit 0
