{
  "permissions": {
    "allow": [
      "command(git (status|diff|log).*)",
      "command(npm run (lint|test|build).*)",
      "command(pytest.*)",
      "command(ruff check.*)",
      "command(go test.*)",
      "command(cargo test.*)",
      "command(dotnet test.*)"
    ],
    "ask": [
      "command(git (checkout|branch|add|commit|push).*)",
      "command(gh pr (create|view|diff).*)",
      "command(npm install.*)",
      "command(pip install.*)",
      "command(composer install.*)"
    ],
    "deny": [
      "command(git push.* (main|master).*)",
      "command(git push.*--force.*)",
      "command(git commit.*--no-verify.*)",
      "command(git push.*--no-verify.*)",
      "command(git (tag|merge|rebase).*)",
      "command(gh pr merge.*)",
      "command(gh release.*)",
      "command(npm publish.*)",
      "command(sudo.*)",
      "command(rm -rf.*)",
      "read_file(.env.*)",
      "read_file(secrets/)",
      "read_file(.*\\.(pem|key))",
      "write_file(.env.*)",
      "write_file(.git/)",
      "write_file(AGENTS.md)",
      "write_file(.claude/)",
      "write_file(.cursor/)",
      "write_file(.agents/)",
      "write_file(.github/workflows/)",
      "write_file(.github/scripts/)",
      "write_file(.github/CODEOWNERS)",
      "write_file(.GCC/PROTOCOL.md)",
      "write_file(.githooks/)",
      "write_file(review-policy.md)",
      "write_file(agent-policy.md)"
    ]
  }
}
