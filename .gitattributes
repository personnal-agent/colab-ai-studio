# Auto-detect text files and normalize line endings to LF on checkout/commit
* text=auto eol=lf

# Force LF on shell scripts and hooks across all platforms (Windows, Linux, macOS)
.githooks/** text eol=lf
.githooks/* text eol=lf
*.sh text eol=lf

# Source code and configuration files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.ipynb text eol=lf
