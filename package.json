{
  "name": "omniforge",
  "version": "1.3.0",
  "description": "Omniforge — Studio IA hybride & Orchestrateur Multi-Agents",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "build:frontend": "npm --prefix frontend run build",
    "electron:dev": "npm run build:electron && electron dist-electron/main.js",
    "electron:start": "npm run build:electron && electron dist-electron/main.js",
    "test:frontend": "npm --prefix frontend test -- --run",
    "test:backend": "/home/instructeur/.venvs/colab-ai-studio/bin/pytest tests/",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "ruff check app/ tests/ scripts/"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "eslint": "^8.57.1",
    "typescript": "^5.5.4",
    "wait-on": "^7.2.0"
  }
}
